# Puerto del servidor Express
PORT=3000

# Ponlo a "production" al desplegar. Activa el guardarraiz de src/config.js:
# sin JWT_SECRET el servidor no arranca, en vez de usar el valor por defecto,
# que esta escrito en un repositorio publico y permitiria falsificar sesiones.
# En local dejalo sin definir.
# NODE_ENV=production

# Secreto de firma de los JWT. En produccion, valor largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Caducidad de los tokens
JWT_EXPIRES_IN=2h

# Ruta de la base SQLite. Por defecto ./kohi.db en la raiz del proyecto.
KOHI_DB_PATH=./kohi.db
