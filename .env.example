# Puerto del servidor Express
PORT=3000

# Ponlo a "production" al desplegar. Activa el guardarraiz de src/config.js:
# sin JWT_SECRET el servidor no arranca, en vez de usar el valor por defecto,
# que esta escrito en un repositorio publico y permitiria falsificar sesiones.
# En local dejalo sin definir.
# NODE_ENV=production

# Secreto de firma de los JWT. En produccion, valor largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Caducidad de los tokens
JWT_EXPIRES_IN=2h

# Ruta de la base SQLite. Por defecto ./kohi.db en la raiz del proyecto.
KOHI_DB_PATH=./kohi.db

# Limite de peticiones por IP. Los valores por defecto son los de produccion:
# 10 accesos cada 15 minutos y 5 altas por hora. Se exponen como variables para
# que los tests puedan levantar un servidor con un limite diminuto.
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_REGISTER_WINDOW_MS=3600000

# Saltos de proxy en los que confiar para deducir la IP del cliente.
# 1 es lo correcto detras del proxy de Render. No lo pongas a true: permitiria
# falsificar la IP con una cabecera y esquivar el limite.
# TRUST_PROXY=1
